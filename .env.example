# ============================================================
# Kuya E Tapsilogan POS - environment variables
# Copy this file to ".env" for local development and fill in
# the values from your Supabase project (Dashboard > Project Settings > API).
# ============================================================

# Required - Supabase project URL (e.g. https://abcdefgh.supabase.co)
SUPABASE_URL=

# Required - Supabase "service_role" secret key. KEEP THIS PRIVATE.
# It is only used on the server, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required in production - long random string used to sign session tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Optional
PORT=3000
TIMEZONE=Asia/Manila
SUPABASE_BUCKET=menus
SESSION_HOURS=12
NODE_ENV=development
